@model BookStoree.ViewModels.HomeViewModel

@section Styles {
    <style>
        .book-card {
            border: 2px solid #333;
            padding: 15px;
            margin: 15px;
            width: 250px;
            border-radius: 10px;
            background-color: #f8f9fa;
        }
    </style>
}

<h1 class="text-center mb-4">Book Store</h1>

<h2 class="mb-3">Add New Book</h2>

<form method="post" action="/Home/AddBook">

    <div class="mb-3">
        <label>Book Title</label>
        <input type="text" name="title" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Price</label>
        <input type="number" name="price" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Author</label>
        <select name="authorId" class="form-control" required>
            @foreach (var author in Model.Authors)
            {
                <option value="@author.Id">@author.Name</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Add Book</button>

</form>

<h2 class="mb-3 mt-4">Available Books</h2>

@if (Model.Books.Count == 0)
{
    <p>No books available.</p>
}
else
{
    <div class="row">

        @foreach (var book in Model.Books)
        {
            <div class="col-md-4 mb-4">
                <div class="book-card">

                    <div class="card-body">
                        <h5 class="card-title">@book.Title</h5>

                        <p class="card-text">
                            <strong>Book ID:</strong> @book.Id
                        </p>

                        <p class="card-text">
                            <strong>Author:</strong> @book.AuthorName
                        </p>

                        <p class="card-text">
                            <strong>Price:</strong> Rs. @book.Price
                        </p>

                        <form method="post" action="/Home/RemoveBook"
                              onsubmit="return confirmRemove();">

                            <input type="hidden" name="id" value="@book.Id" />

                            <button type="submit" class="btn btn-danger">
                                Remove
                            </button>

                        </form>
                    </div>

                </div>
            </div>
        }

    </div>
}

<h2 class="mb-3 mt-4">Add New Author</h2>

<form method="post" action="/Home/AddAuthor">

    <div class="mb-3">
        <label>Author Name</label>
        <input type="text" name="name" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Country</label>
        <input type="text" name="country" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-success">Add Author</button>

</form>

<h2 class="mb-3 mt-4">Our Authors</h2>

<table class="table table-bordered table-striped">

    <thead class="table-dark">
        <tr>
            <th>Author ID</th>
            <th>Name</th>
            <th>Country</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var author in Model.Authors)
        {
            <tr>
                <td>@author.Id</td>
                <td>@author.Name</td>
                <td>@author.Country</td>
            </tr>
        }
    </tbody>

</table>

@section Scripts {
    <script>
        function confirmRemove() {
            return confirm("Remove this book?");
        }
    </script>
}